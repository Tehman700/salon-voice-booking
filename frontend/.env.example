# Copy to frontend/.env.local. Never commit the real file.
# Where the FastAPI backend runs; the browser calls /api/* on this app and Next.js proxies it there.
# 127.0.0.1 rather than localhost: on Windows, localhost tries IPv6 first and stalls.
BACKEND_URL=http://127.0.0.1:8000

# true  -> run entirely on built-in sample data (no backend needed): best for demos.
# false -> use the real FastAPI backend. Today that covers sign-in, business, locations and team;
#          services, staff, bookings, customers and calls arrive with later backend modules.
NEXT_PUBLIC_API_MOCKS=true
