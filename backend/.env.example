# Copy to backend/.env for local development. Never commit the real .env.
ENVIRONMENT=local
LOG_LEVEL=INFO
# 127.0.0.1 rather than localhost: on Windows, localhost tries IPv6 first and every connection stalls ~2s.
DATABASE_URL=postgresql+asyncpg://salon:salon@127.0.0.1:5544/salon
CORS_ORIGINS=http://localhost:3000

# Used by pytest (separate database, wiped on every test run)
TEST_DATABASE_URL=postgresql+asyncpg://salon:salon@127.0.0.1:5544/salon_test

# --- Auth (optional locally; JWT_SECRET is REQUIRED, >= 32 chars, in staging/production) ---
# JWT_SECRET=
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=30
# REFRESH_COOKIE_PATH=/api/auth
# COOKIE_SECURE=            # default: true except local/test
# EXPOSE_INVITE_TOKENS=     # default: true only in local/test (until emails exist in M7)
