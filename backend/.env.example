# Copy to backend/.env for local development. Never commit the real .env.
ENVIRONMENT=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://salon:salon@localhost:5544/salon
CORS_ORIGINS=http://localhost:3000

# Used by pytest (separate database, wiped on every test run)
TEST_DATABASE_URL=postgresql+asyncpg://salon:salon@localhost:5544/salon_test
